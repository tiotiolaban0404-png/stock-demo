# ---------------------------------------------------------------------------
# config.ini - copy ke config.ini (demo Stock Bot)
# Isi: token/chat_id/smtp sesuai akun kamu.
# Kamu juga bisa pakai env variabel.
# ---------------------------------------------------------------------------
[saham]
; Daftar emiten (ini demo: watchlist_demo.txt)
watchlist = demo/watchlist_demo.txt

[telegram]
; Ganti dengan token ya dari @BotFather
token =

; Private chat id (satu-satu, dari DM dengan bot)
chat_id =

; Grup Telegram - satu chat id per baris
; Cara dapat: tambah bot ke grup, lalu GET https://api.telegram.org/bot<TOKEN>/getUpdates
; atau cek chat_id di channel group
group_chat_ids =

; Optional: override semua destinasi (private + groups) -> mengirim langsung ke daftar
; comma-separated chat ids (private terlebih dahulu, lalu grup)
; contoh: 7401634640,123456789,987654321
all_destinations =

[smtp]
host = smtp.gmail.com
port = 587
user =
pass =
use_tls = true

[report]
subject = Laporan Saham {date}
email_from =
email_to =

[imap]
host = imap.gmail.com
port = 993
user =
pass =
folder = INBOX
days = 1
